# ---------- Etkinlik ----------
EVENT_TITLE="Şafak & Öykü Nişan Töreni"
# Serbest metin, sayfada başlığın altında görünür (boş bırakılabilir)
EVENT_DATE="1 Kasım 2026"
# public/ altındaki bir dosya (ör. /kapak.jpg) ya da tam URL. Boşsa dekoratif arka plan kullanılır.
EVENT_COVER_IMAGE=""
# Sitenin herkese açık adresi (QR kodu ve kartlar için)
SITE_URL="https://ani-albumu.vercel.app"

# ---------- Cloudflare R2 ----------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="ani-albumu"
# İsteğe bağlı: AB bucket'ı için https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=""

# ---------- Veritabanı (Turso / libSQL) ----------
# Yerelde denemek için: TURSO_DATABASE_URL="file:yerel.db" (token gerekmez)
TURSO_DATABASE_URL="libsql://ani-albumu-kullaniciadi.turso.io"
TURSO_AUTH_TOKEN=""

# ---------- Güvenlik ----------
# Uzun rastgele bir değer: `openssl rand -hex 32`
SESSION_SECRET=""
# Admin paneli şifresi
ADMIN_PASSWORD=""
# Galeri şifresi; boş bırakılırsa galeri şifresizdir
GALLERY_PASSWORD=""
# Bir IP adresinden 10 dakikada başlatılabilecek en fazla yükleme sayısı.
# Salon Wi-Fi'ında tüm misafirler aynı IP'yi paylaşabilir; bu yüzden cömert tutun.
UPLOAD_RATE_LIMIT_PER_10MIN="400"

# ---------- Limitler (MB) ----------
MAX_PHOTO_MB="25"
MAX_VIDEO_MB="500"

# ---------- Scriptler ----------
# npm run cards: A4'e basılacak toplam kart sayısı
CARD_COUNT="20"
